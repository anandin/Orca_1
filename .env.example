# ── Required: at least one LLM provider ──────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ── Required: Samskara Brain ─────────────────────────────
# Tenant key from samskara-mind.replit.app
SAMSKARA_API_KEY=sk_8eaa778c11e3977593bc51cbabf9298723c71c7e0d53a023
SAMSKARA_AGENT_ID=orca-v1

# ── Auto-generated if not set ────────────────────────────
# ORCA_GATEWAY_TOKEN=change-me-to-a-long-random-token

# ── Optional: Channel connections ────────────────────────
# TELEGRAM_BOT_TOKEN=...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# WHATSAPP_API_KEY=...
# SIGNAL_NUMBER=+1...

# ── Optional: Extra capabilities ─────────────────────────
# BRAVE_API_KEY=...          # Web search
# DEEPGRAM_API_KEY=...       # Voice transcription
# ELEVENLABS_API_KEY=...     # Voice synthesis (JARVIS voice)
